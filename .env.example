# =========================================================================
# CONFIGURACIÓN DEL SERVIDOR LOCAL (OPCIONAL)
# =========================================================================
# Puerto en el que correrá Vite localmente (por defecto es 5173)
PORT=5173

# =========================================================================
# APIS Y SERVICIOS (OBLIGATORIO)
# =========================================================================
# URL base de tu API Backend (donde Express está escuchando)
# Para desarrollo local suele ser http://localhost:3000 o http://localhost:5000
VITE_API_URL=http://localhost:3000

# Versión de la API si tu backend maneja prefijos de versionado (ej. /v1)
VITE_API_VERSION=v1

# =========================================================================
# SERVICIOS DE TERCEROS (INTEGRACIONES PÚBLICAS)
# =========================================================================
# NOTA: Recuerda que estas llaves se compilan en el cliente.
# Asegúrate de que en tus paneles de Firebase/Supabase/Google estén restringidas por dominio.

# Firebase Configuration (Si usas Firebase Auth/Firestore)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id

# Supabase Configuration (Alternativa a Firebase)
#VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anonymous-key

# Google Analytics / Tag Manager
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =========================================================================
# CONFIGURACIONES DE ENTORNO / FLAGS
# =========================================================================
# Nombre de la aplicación visible en títulos o encabezados
VITE_APP_NAME=Raizal Portfolio

# Modo de la aplicación (development, production, staging)
VITE_APP_ENV=development

VITE_SUPABASE_URL=https://
VITE_SUPABASE_PUBLISHABLE_KEY=sb